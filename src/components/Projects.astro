    @keyframes openLine{
    0%{
      width: 0%;
    }
    80%{
      width: 48%
    }
    100%{
    width: 50%;
    }
  }
  .linha-divisoria {
    height: 3px;
    width: 50%;
    background-color: #e0e0e0;
    
    margin: 4rem auto;
    border-radius: 2px;
    opacity: 0.2;

    animation: openLine 1.75s ease-out;
  }


  #projects{
    display:flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

 #projects-figures {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* Cria 2 colunas de larguras iguais */
    gap: 2rem; /* Adiciona um espaço agradável entre as colunas e linhas */
    justify-items: center; /* Centraliza os itens dentro das próprias colunas */
    align-items: start; /* Alinha os itens pelo topo (útil se as legendas tiverem tamanhos diferentes) */
    
    width: 90%;
    margin: 0 auto;
  }

  #projects-figures figure a {
    width: 100%;
    display: block;
    position: relative; /* Necessário para ancorar a sobreposição */
    border-radius: 8px; /* Mantém os cantos arredondados */
    overflow: hidden; /* Corta a sobreposição para não vazar das bordas arredondadas */
  }

  /* Cria a camada laranja invisível por cima da imagem */
  #projects-figures figure a::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    
    /* Laranja (DarkOrange) com 30% de opacidade */
    background-color: rgba(255, 140, 0, 0.3); 
    
    opacity: 0; /* Fica invisível por padrão */
    transition: opacity 0.3s ease; /* Faz a cor aparecer de forma suave */
    
    /* Muito importante: impede que a sobreposição bloqueie o clique do mouse no link */
    pointer-events: none; 
  }

  /* Faz a camada aparecer quando o mouse passa por cima do link */
  #projects-figures figure a:hover::after {
    opacity: 1;
  }

  #projects-figures figure img:hover{
    transform: scale(1.05);
  }

  /* Garanta que o seletor da imagem seja flexível o suficiente */
  #projects-figures figure img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center top;
    border-radius: 8px;
    background-color: #f5f5f5;
    display: block; /* Garante que a imagem não crie espaços em branco indesejados */
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  body {
  font-family: 'JetBrainsMono Nerd Font', monospace;
