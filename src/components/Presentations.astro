  #presentations-figures figure a {
    width: 100%;
    display: block;
    position: relative; /* Necessário para ancorar a sobreposição */
    border-radius: 8px; /* Mantém os cantos arredondados */
    overflow: hidden; /* Corta a sobreposição para não vazar das bordas arredondadas */
  }

  /* Cria a camada laranja invisível por cima da imagem */
  #presentations-figures figure a::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    
    /* Laranja (DarkOrange) com 30% de opacidade */
    background-color: rgba(255, 140, 0, 0.3); 
    
    opacity: 0; /* Fica invisível por padrão */
    transition: opacity 0.3s ease; /* Faz a cor aparecer de forma suave */
    
    /* Muito importante: impede que a sobreposição bloqueie o clique do mouse no link */
    pointer-events: none; 
  }

  /* Faz a camada aparecer quando o mouse passa por cima do link */
  #presentations-figures figure a:hover::after {
    opacity: 1;
  }

  #presentations-figures figure img:hover{
    transform: scale(1.05);
  }

  /* Garanta que o seletor da imagem seja flexível o suficiente */
